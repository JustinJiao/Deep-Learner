# ==========================================
# 1. 敏感信息 (极其重要！)
# ==========================================
.env
*.env
.env.*

# ==========================================
# 2. Python 缓存与构建产物 (解决 egg-info 问题)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/

# 这里的核心是忽略构建元数据
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==========================================
# 3. Chainlit 特有忽略 (解决你截图中的翻译文件问题)
# ==========================================
# 我们通常保留 config.toml，但忽略自动生成的翻译
.chainlit/translations/
interface/.chainlit/translations/

# 如果你不需要保留任何 Chainlit 自动生成的配置
# .chainlit/
# interface/.chainlit/

# ==========================================
# 4. macOS 系统文件
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ==========================================
# 5. 数据、日志与本地存储 (防止上传巨大 PDF 或数据库)
# ==========================================
data/docs/
data/storage/
*.pdf
*.db
*.sqlite3
*.log
# 忽略那些奇怪的哈希临时文件
[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*

# ==========================================
# 6. IDE 配置
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# 7. AI 模型与本地缓存
# ==========================================
models/
.cache/
huggingface_cache/

# ==========================================
# 8. Spark & 临时文件
# ==========================================
spark-warehouse/
metastore_db/
derby.log
checkpoint/
tmp/