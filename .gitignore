# ==========================================
# 1. 敏感信息
# ==========================================
.env
*.env
.env.*

# ==========================================
# 2. Python 缓存与构建产物
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
*.egg-info/
build/
dist/

# ==========================================
# 3. Chainlit 特有忽略 (解决截图中的翻译文件)
# ==========================================
.chainlit/translations/
interface/.chainlit/translations/
# 忽略那些长哈希值的临时文件
[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*

# ==========================================
# 4. 系统与 IDE 文件
# ==========================================
.DS_Store
.vscode/
.idea/

# ==========================================
# 5. 数据与日志 (防止上传巨大 PDF)
# ==========================================
data/docs/
data/storage/
*.pdf
*.db
*.log