# ==========================================
# 1. 敏感信息 (极其重要！防止 API Key 泄露)
# ==========================================
.env
*.env
.env.*
# 再次提醒：你刚才在对话中贴出的 Key 已暴露，请务必去后台撤销并更换

# ==========================================
# 2. Python 缓存与环境 (基于你的版本升级)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# 3. macOS 系统文件 (针对你的 MacBook Pro)
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ==========================================
# 4. 数据与本地文档 (防止上传巨大的 PDF)
# ==========================================
data/docs/
data/storage/
*.pdf
*.db
*.sqlite3
*.log

# ==========================================
# 5. IDE 配置 (针对你的开发工具)
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# 6. AI 模型与本地缓存 (针对你的 Reranker)
# ==========================================
# 防止本地 BGE-Reranker 权重或 HuggingFace 缓存上传
models/
.cache/
huggingface_cache/

# ==========================================
# 7. Spark & 临时文件 (针对你的数据工程逻辑)
# ==========================================
# 忽略 Spark 运行产生的元数据和检查点
spark-warehouse/
metastore_db/
derby.log
checkpoint/
tmp/