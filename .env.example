# =========================
# Deep-Learner Env Template
# =========================

# ---- Infrastructure ----
ES_HOST=localhost
ES_PORT=9200
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ---- Index / Collection ----
ES_INDEX_NAME=deep_learner_knowledge
MILVUS_COLLECTION_NAME=deep_learner_vectors
MILVUS_LTM_COLLECTION=user_long_term_memory

# ---- Providers ----
DEFAULT_LLM_PROVIDER=openai
DEFAULT_EMBEDDING_PROVIDER=openai
LLM_ROUTING_ENABLED=true

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_COMPOSE_MODEL=gpt-4.1
OPENAI_VERIFY_MODEL=gpt-4o-mini
OPENAI_REWRITE_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# ---- Anthropic ----
ANTHROPIC_API_KEY=
ANTHROPIC_COMPOSE_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MEMORY_MODEL=claude-3-haiku-20240307
ANTHROPIC_TEMPERATURE=0
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_MAX_RETRIES=2

# ---- Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_TEMPERATURE=0
OLLAMA_TIMEOUT_SECONDS=60

# ---- Parser (Unstructured) ----
UNSTRUCTURED_STRATEGY=fast
UNSTRUCTURED_LANGUAGES=eng
UNSTRUCTURED_INFER_TABLE_STRUCTURE=false
PDF_EXTRACT_TABLES_WITH_PDFPLUMBER=true
PDF_PDFPLUMBER_MAX_PAGES=0
PDFPLUMBER_VERTICAL_STRATEGY=text
PDFPLUMBER_HORIZONTAL_STRATEGY=text

# ---- Chunk ----
CHUNK_SIZE=1600
CHUNK_OVERLAP_LINES=10

# ---- Embedding ----
EMBEDDING_DIM=1536
EMBED_BATCH_SIZE=16

# ---- Fusion / Retrieval ----
RRF_K=30
RECALL_TOP_K=120
PHASE1_VECTOR_TOP_K=220
PHASE1_KEYWORD_TOP_K=260
PHASE1_RERANK_TOP_N=180
PHASE2_VECTOR_TOP_K=360
PHASE2_KEYWORD_TOP_K=420
PHASE2_RERANK_TOP_N=280
RETRIEVAL_EXPAND_GENERIC_MULTI_COMPANY=true
FINAL_TOP_K=20
RETRIEVAL_RESTRICT_TO_ALLOWED_SOURCES=true
RETRIEVAL_ALLOWED_SOURCES=Amazon 10K 2024.pdf,Alphabet 10K 2024.pdf,MSFT 10-K.pdf

# ---- Milvus Index / Search ----
MILVUS_INDEX_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=HNSW
MILVUS_INDEX_M=8
MILVUS_INDEX_EF_CONSTRUCTION=64
MILVUS_SEARCH_METRIC_TYPE=COSINE
MILVUS_SEARCH_NPROBE=10
MILVUS_LTM_SEARCH_METRIC_TYPE=COSINE
MILVUS_LTM_SEARCH_EF=64

# ---- Rerank Gate ----
RETRIEVAL_SCORE_GATE_ENABLED=false
RETRIEVAL_MIN_RERANK_SCORE=0.00
RETRIEVAL_ENFORCE_SOURCE_COVERAGE=true
RETRIEVAL_MIN_SOURCE_COVERAGE=3
RETRIEVAL_SOURCE_COVERAGE_WINDOW_TOP_K=24

# ---- Runtime / Verification ----
RUNTIME_V2_ENABLED=true
RUNTIME_MAX_TRANSITIONS=12
RUNTIME_ENFORCE_CONTRACT=true
RUNTIME_COMPOSE_CONTEXT_TOP_K=24
RUNTIME_VERIFY_CONTEXT_TOP_K=24
RUNTIME_FORCE_RETRIEVE_WHEN_MEMORY_SUFFICIENT=true
RUNTIME_FORCE_ANSWER_ON_EVIDENCE=true
RUNTIME_REPAIR_EXTRACTIVE_FALLBACK=false
MAX_REPAIR_LOOPS=3
MAX_STEPS_LOG=200
VERIFY_PASS_SCORE_THRESHOLD=0.70
STRICT_VERIFY_PASS_SCORE_THRESHOLD=0.78
MEMORY_SUFFICIENT_SCORE_THRESHOLD=0.70
SV_WEIGHT_CITATION=0.50
SV_WEIGHT_HALLUCINATION=0.10
SV_WEIGHT_LOGIC=0.25
SV_WEIGHT_COMPLETENESS=0.10
SV_WEIGHT_FORMAT=0.05
SV_TOTAL_THRESHOLD=2.8
SV_CRITICAL_SCORE_FLOOR=-0.01
SV_BLOCK_UNSUPPORTED_CLAIM=false

# ---- LTM ----
LTM_SEARCH_PREFIX=search_query:
LTM_RECALL_TOP_K=5
LTM_RECALL_THRESHOLD=0.4
LTM_IMPORTANCE_THRESHOLD=0.7

# ---- Reranker ----
RERANK_MODEL_PATH=BAAI/bge-reranker-base
RERANK_DEVICE=cpu

# ---- Ingestion Runtime ----
DOCS_PATH=data/10k
INGEST_PARSE_WORKERS=3
INGEST_WRITE_BATCH_CHUNKS=96
INGEST_RESET_TARGET=false
